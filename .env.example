# ----------------------------------------------------------------------
# landscape-change-detection-pipeline — example environment file
#
# Copy to .env and fill in real values. Never commit the real .env (it is
# gitignored). Referenced from configs/config.yaml via ${VAR} placeholders.
# ----------------------------------------------------------------------

# Root directory for downloaded raw data (tiles, DEM, scenes)
DATA_ROOT=CHANGE_ME

# Root directory for pipeline outputs (inference maps, composites, stats)
OUTPUT_ROOT=CHANGE_ME

# Root directory for trained model checkpoints
MODEL_ROOT=CHANGE_ME

# Google Earth Engine project id used for scene search/download (see
# gee.project in the config). Leave unset to use interactive OAuth2 via
# `earthengine authenticate`, stored outside this repo in
# ~/.config/earthengine/.
EE_PROJECT=CHANGE_ME
